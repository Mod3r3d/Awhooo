# --- Bắt buộc ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- Tùy chọn: đồng bộ slash command nhanh vào 1 server khi test (để trống = sync global, mất ~1h để lan toả) ---
DEV_GUILD_ID=

# --- Tùy chọn: đường dẫn Deno runtime cho yt-dlp giải mã PO Token / JS challenge của YouTube ---
# Để trống nếu đã cài Deno vào PATH hệ thống.
DENO_PATH=

# --- Tùy chọn: đường dẫn tới cookies.txt (định dạng Netscape) để bypass 403 Forbidden ---
YTDLP_COOKIES_FILE=

# --- Tùy chọn: endpoint của PO Token Provider chạy nền (bgutils-ytdlp-pot-provider), ví dụ http://127.0.0.1:4416 ---
# Xem hướng dẫn triển khai trong README_V2.md mục "1.4"
POT_PROVIDER_URL=

# --- Tùy chọn: bật fallback SoundCloud khi YouTube trả 403 / bị chặn ---
ENABLE_SOUNDCLOUD_FALLBACK=true

# --- Tùy chọn: số giây chờ trước khi tự rời phòng voice khi không còn ai nghe ---
AUTO_DISCONNECT_SECONDS=180

# --- Tùy chọn: số giây trước khi bài hát kết thúc để bắt đầu pre-fetch bài kế tiếp ---
PREFETCH_LEAD_SECONDS=18

# ============================================================
# Cấu hình Lavalink
# ============================================================

# Cách 1 (khuyên dùng): khai báo danh sách node dạng JSON
# LAVALINK_NODES=[{"name":"Node-1","url":"lavalink.example.com:443","auth":"mat-khau","secure":true}]

# Cách 2: node chính, các node công khai mặc định vẫn được dùng làm dự phòng
LAVALINK_HOST=
LAVALINK_AUTH=
LAVALINK_SECURE=true

# ============================================================
# Cấu hình vận hành (tất cả đều tùy chọn, có giá trị mặc định)
# ============================================================

# Mức log: error | warn | info | debug
LOG_LEVEL=info

# Ngôn ngữ giao diện (hiện hỗ trợ: vi)
DEFAULT_LOCALE=vi

# Số bài tối đa trong hàng đợi của một server
MAX_QUEUE_SIZE=500

# Số bài tối đa một người được thêm vào hàng đợi
MAX_QUEUE_SIZE_PER_USER=100

# Số bài tối đa nạp từ một playlist trong một lần
MAX_PLAYLIST_LOAD=100

# Cooldown giữa hai lần dùng lệnh phát nhạc của cùng một người (ms)
COMMAND_COOLDOWN_MS=3000

# Thời gian sống của cache tìm kiếm (ms)
SEARCH_CACHE_TTL_MS=300000

# Số kết quả tìm kiếm tối đa lưu trong cache
SEARCH_CACHE_MAX=200

# Số kết quả hiển thị trong menu /search (tối đa 25)
SEARCH_MENU_RESULTS=10

# Âm lượng mặc định của player (1-200)
DEFAULT_VOLUME=130

# Số bài tối đa lưu trong lịch sử phát nhạc
MAX_HISTORY=50

# Bật autoplay mặc định cho server mới
AUTOPLAY_DEFAULT=false

# Thư mục lưu dữ liệu bền vững (cài đặt + lịch sử theo server)
DATA_DIR=./data

# Endpoint thu thập lỗi (tùy chọn, ví dụ Sentry DSN). Để trống để tắt.
SENTRY_DSN=
